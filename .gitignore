# ================================================
# .gitignore para Cara Core MKT Releases
# ================================================

# Arquivos de compilação Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.dist-info/

# Builds e binários locais
*.manifest
*.exe
*.bat


# Arquivos de log
cycle_log.txt
*.log

# Ambientes virtuais Python
venv/
env/
ENV/
.venv/
.env/

# IDEs e editores
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Arquivos temporários do Windows
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp

# Arquivos de backup
*.bak
*.backup
*.old
*~

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Outros arquivos Python
*.pyo
*.pyd
*.db
*.sqlite3

# Arquivos de configuração local
config.local.*
settings.local.*

# Arquivos sensíveis (se houver)
secrets/
credentials/
*.key
*.pem

# Observação:
# O repositório de releases mantém apenas a loja, a documentação,
# o wiki e os downloads oficiais do Cara Core MKT.